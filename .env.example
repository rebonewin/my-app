# =============================================================================
#  1Security — environment reference
# =============================================================================
#  Copy to `.env.local` for local development. In production (Vercel) set the
#  same keys under Project → Settings → Environment Variables.
#
#  Every value below is read by the application. Optional keys are marked
#  OPTIONAL: when they are absent the dependent feature is disabled and the
#  security dashboard reports it as a configuration gap instead of failing.
# =============================================================================

# --- Core identity -----------------------------------------------------------
# Secret used to sign sessions, tokens and encrypted payloads.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Canonical origin of the deployment. Drives OAuth callbacks, email links and
# the WebAuthn origin. Must be the exact public URL, no trailing slash.
# Local: http://localhost:3000   Production: https://your-domain
BETTER_AUTH_URL=http://localhost:3000

# Public site URL, used by the browser client and appended to trusted origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres) -------------------------------------------
# Runtime connection: Supabase transaction pooler (port 6543). pgbouncer=true
# and prepare:false are required — the pooler runs in transaction mode.
# Host is derived from the Supabase project ref: <ref>.<region>.pooler.supabase.com
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migration/seed connection: Supabase session pooler (port 5432). The direct
# db.<ref>.supabase.co host is IPv6-only on new projects and often unreachable.
DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Supabase storage --------------------------------------------------------
# OPTIONAL. Enables report artifact storage; the admin checklist shows it as a
# configuration gap when unset.
SUPABASE_SERVICE_ROLE_KEY=

# --- OAuth providers ---------------------------------------------------------
# OPTIONAL. Each provider appears on the sign-in screen only when its client ID
# and secret are both present. Redirect URI for every provider:
#   {BETTER_AUTH_URL}/api/auth/callback/<provider>
# (google, github, microsoft, linkedin, apple)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" for multi-tenant, or a specific directory (tenant) ID.
MICROSOFT_TENANT_ID=common

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Apple requires a paid Apple Developer account. The client secret is a signed
# JWT supplied by Apple's tooling — it expires and must be rotated.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=

# --- Transactional email -----------------------------------------------------
# OPTIONAL. Resend takes precedence over SMTP when both are configured.
# Needed for verification, password reset and email OTP delivery.
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Display name and address on outgoing mail. EMAIL_FROM wins over SMTP_FROM.
EMAIL_FROM=1Security <no-reply@your-domain>
SMTP_FROM=

# --- SMS OTP -----------------------------------------------------------------
# OPTIONAL. Enables SMS second factor; the option is hidden without it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Threat intelligence -----------------------------------------------------
# OPTIONAL. When unset, geo/ASN enrichment and reputation scoring degrade to
# local heuristics; the security dashboard flags the missing provider.
IPINFO_TOKEN=
ABUSEIPDB_API_KEY=

# --- Passkeys (WebAuthn) -----------------------------------------------------
# OPTIONAL. Defaults to the hostname of BETTER_AUTH_URL in production and
# "localhost" in development. Set explicitly when serving a custom domain so
# credentials stay bound to the stable domain rather than a preview URL.
# Must be a bare domain (no scheme, no port).
PASSKEY_RP_ID=

# --- Bootstrap super admin ---------------------------------------------------
# Used by `npm run seed` only. Change the password after first sign-in; the
# account is created once and never overwritten.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Legacy fallback if SUPER_ADMIN_EMAIL is unset.
ADMIN_EMAIL=

# --- Tooling -----------------------------------------------------------------
# Target for `npm run smoke`. Defaults to http://localhost:3000.
SMOKE_BASE=http://localhost:3000

# Injected automatically by Vercel; listed here for completeness.
VERCEL_URL=
